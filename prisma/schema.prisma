generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per Clerk user. The id field IS the Clerk user id (e.g. "user_abc")
// — no extra mapping table needed. Defaults + per-user Meta credentials live
// here too, replacing the previous singleton Settings model.
model User {
  id        String  @id // Clerk userId
  email     String  @unique
  firstName String?
  lastName  String?

  // Per-user Meta WhatsApp Cloud API credentials. Token is encrypted at rest
  // via lib/encrypt.ts (AES-256-CBC). Never returned to the browser raw.
  whatsappApiToken          String? // encrypted: "<iv-hex>:<ciphertext-hex>"
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  whatsappApiVersion        String  @default("v25.0")
  webhookVerifyToken        String?

  // User-level defaults (replaces the Settings singleton).
  defaultCountryCode String @default("1")
  defaultDelayMs     Int    @default(2000)

  // Set the first time the user finishes the onboarding wizard — either by
  // saving their Meta credentials OR by clicking "Skip for now". Used by /
  // and /onboarding to know whether to send the user through setup. Acts as
  // a belt-and-suspenders against Clerk's NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL
  // not being configured in every environment.
  //
  // Set BOTH onboardingCompletedAt AND wizardCompletedAt when the new
  // Phase 7 wizard reaches its final step — keeps the legacy dashboard
  // redirect logic happy.
  onboardingCompletedAt DateTime?

  // Phase 7 guided setup wizard progress. wizardStep stores the highest
  // step the user has reached (never advances backwards in the DB even if
  // the user clicks Back in the UI), so if they close the browser they
  // resume where they left off. setupRequestedAt is set when the user
  // clicks "Get Help Setting Up" — surfaces in /admin so we can act on it.
  wizardStep        Int       @default(1)
  wizardStartedAt   DateTime?
  wizardCompletedAt DateTime?
  setupRequestedAt  DateTime?

  // Phase 8.1 — Done-For-You Setup paid via Stripe ($149 one-time).
  // setupPaid flips true when the Stripe `checkout.session.completed`
  // webhook fires with metadata.serviceType="done_for_you_setup".
  // setupPaymentId stores the underlying PaymentIntent id so admins
  // can reconcile in Stripe Dashboard.
  setupPaid       Boolean @default(false)
  setupPaymentId  String?

  // ── Billing (Phase 4) ─────────────────────────────────────────────────
  // Plan id matches keys in lib/plans.ts PLANS — the single source of truth
  // for limits/features. NEVER hardcode plan limits anywhere else.
  plan String @default("free") // free | starter | growth | pro

  // Billing interval — "month" or "year". Set by the Stripe webhook based
  // on which price id the subscription is bound to. Used by the admin
  // MRR calc (annual plans / 12) and by the billing UI to render the
  // right price on the current-plan card.
  billingInterval String @default("month") // month | year

  // Stripe customer + subscription identity. Set the first time the user
  // hits checkout; updated on every subscription event via the webhook.
  stripeCustomerId         String? @unique
  stripeSubscriptionId     String? @unique
  stripeSubscriptionStatus String? // active | canceled | past_due | trialing | incomplete | null
  stripePriceId            String?

  // Stripe-reported billing period (for "renews on" / "access until" copy).
  // Distinct from usagePeriodStart below: these come from Stripe and reflect
  // the SUBSCRIPTION's period, while usagePeriod tracks the message counter.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // True when the user has cancelled but still has access until period end.
  cancelAtPeriodEnd Boolean @default(false)

  // ── Usage tracking ─────────────────────────────────────────────────────
  // Counter reset to 0 by the invoice.paid webhook each billing cycle.
  messagesUsedThisMonth Int      @default(0)
  usagePeriodStart      DateTime @default(now())

  // ── Moderation (Phase 5 admin) ─────────────────────────────────────────
  // When true, send + template-create routes return 403 with a support copy.
  // Toggled from /admin/users/[id]/suspend.
  suspended Boolean @default(false)

  // ── White-label branding (Pro only, gated by whiteLabelReports) ────────
  // Fields drive the PDF report header + footer. Editable on Pro only,
  // but readable on every plan (so the Branding settings page can show
  // a locked preview). See app/api/branding/route.ts for the plan gate.
  companyName             String?  // defaults from firstName+lastName when blank
  logoUrl                 String?  // Vercel Blob URL; nulled when removed
  accentColor             String   @default("#25D366")
  footerText              String?  // free-form single line for agency contact
  hideSwiftReachBranding  Boolean  @default(false)

  campaigns          Campaign[]
  templates          MessageTemplate[]
  scheduledCampaigns ScheduledCampaign[]
  savedContacts      SavedContact[]
  contactGroups      ContactGroup[]
  inboundMessages    InboundMessage[]
  outboundReplies    OutboundReply[]
  supportRequests    SupportRequest[]
  apiKeys            ApiKey[]
  campaignAlerts     CampaignAlert[]
  automations        Automation[]
  reportGenerations  ReportGeneration[]
  clients            Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id String @id @default(cuid())

  // userId is nullable during the Phase 3 transition. Once all existing rows
  // have been backfilled (or wiped), this is changed to required.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  mode         String
  templateName String?
  rawMessage   String?
  staticVars   String    @default("{}")
  variableMap  String    @default("[]")
  formatRules  String    @default("{}")
  phoneColumn  String
  delayMs      Int       @default(2000)
  status       String    @default("draft")
  totalCount   Int       @default(0)
  sentCount    Int       @default(0)
  failedCount  Int       @default(0)
  skippedCount Int       @default(0)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  contacts     Contact[]

  // Post-campaign analysis: set when the alert engine has run for
  // this campaign. Idempotency guard — analysis runs at most once.
  alertsSentAt DateTime?
  alerts       CampaignAlert[]

  // Auto-retry engine (lib/retryEngine.ts). autoRetryEnabled defaults
  // to true — users can opt out per campaign. autoRetryRanAt acts as
  // the idempotency guard (cron never retries the same campaign
  // twice). retriedContactCount and retryDelivered summarize the
  // outcome of the auto-retry pass so the campaign detail page can
  // render "N of M delivered on retry" without a live count.
  autoRetryEnabled     Boolean   @default(true)
  autoRetryAt          DateTime?
  autoRetryRanAt       DateTime?
  retriedContactCount  Int       @default(0)
  retryDelivered       Int       @default(0)

  // Per-client label (Pro feature). Nullable; a null value means
  // "unassigned" and matches the "Unassigned" filter option.
  // onDelete: SetNull so deleting a client leaves the campaign
  // and its message history intact — the label just clears.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, clientId])
}

model Contact {
  id                  String    @id @default(cuid())
  campaignId          String
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phoneNumber         String
  rowData             String
  personalizedMessage String
  whatsappMsgId       String?
  status              String    @default("pending")
  errorMessage        String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?

  // Retry engine (lib/retryEngine.ts). retryCount tracks how many
  // times THIS specific contact has been retried; retryStatus is the
  // outcome of the last retry attempt ("sent" | "failed" | null).
  retryCount          Int       @default(0)
  lastRetryAt         DateTime?
  retryStatus         String?

  @@index([campaignId])
  @@index([whatsappMsgId])
}

model MessageTemplate {
  id String @id @default(cuid())

  // userId is nullable during the Phase 3 transition. See Campaign.userId.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  content     String
  staticVars  String    @default("{}")
  formatRules String    @default("{}")
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// DEPRECATED: replaced by per-user fields on the User model. Kept temporarily
// so existing code paths keep compiling during the Phase 3 transition. Will
// be removed after settings UI is migrated to the User record.
model Settings {
  id                 String @id @default("singleton")
  defaultCountryCode String @default("1")
  defaultDelayMs     Int    @default(2000)
}

// ── Phase 5: admin observability ─────────────────────────────────────────
// Captured by lib/errorLog.ts in catch blocks of critical routes (send,
// webhooks, settings). Surfaced in /admin/system. Should NEVER contain
// decrypted credentials — log the route name + sanitized message only.
model ErrorLog {
  id        String   @id @default(cuid())
  route     String
  message   String
  stack     String?
  userId    String?
  severity  String   @default("error") // error | warning
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity])
}

// In-app banner created in /admin/announcements. Only one row should be
// active at any time — publishing a new banner deactivates existing ones
// (handled in the API route's transaction).
model Announcement {
  id        String   @id @default(cuid())
  message   String
  type      String   @default("info") // info | warning | success
  target    String   @default("all")  // all | free | paid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ── Phase 6: scheduled + recurring campaigns ─────────────────────────────
// One row per scheduled send. The cron at /api/cron/send-scheduled scans
// every minute, materialises due rows into a real Campaign + Contact[]
// graph, and triggers the same send pipeline as an immediate campaign.
//
// `contactListData` stores the resolved contact rows as JSON so the cron
// has everything it needs without re-running CSV parsing or contact-book
// queries.
model ScheduledCampaign {
  id              String  @id @default(cuid())
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  mode            String  // freeform | template
  templateName    String?
  rawMessage      String?
  staticVars      String  @default("{}")
  variableMap     String  @default("[]")
  formatRules     String  @default("{}")
  phoneColumn     String
  delayMs         Int     @default(2000)
  contactListData String  @default("[]") // JSON array of contact row objects
  status          String  @default("scheduled")
  // scheduled | running | completed | failed | cancelled

  scheduledFor  DateTime
  timezone      String    @default("America/Los_Angeles")
  recurring     Boolean   @default(false)
  recurrence    String? // daily | weekly | monthly
  recurrenceDay Int? // weekly: 0=Sun..6=Sat, monthly: 1..31
  lastRunAt     DateTime?
  nextRunAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, scheduledFor])
}

// ── Phase 6: contact book ────────────────────────────────────────────────
// Persistent per-user contact storage. The unique (userId, phoneNumber)
// constraint prevents duplicates when re-importing the same CSV. `data`
// is free-form JSON of every column the user wants to remember about the
// contact (e.g. {"Name":"John","Balance":150}).
model SavedContact {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String
  data        String    @default("{}") // JSON of arbitrary fields
  groupIds    String    @default("[]") // JSON array of ContactGroup ids
  optedOut    Boolean   @default(false)
  optedOutAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Per-client label (Pro feature). Nullable; deleting a client
  // clears the label but never removes the contact. See Client
  // model for the ownership + archive semantics.
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([userId, phoneNumber])
  @@index([userId])
  @@index([userId, optedOut])
  @@index([userId, clientId])
}

// Soft container for grouping contacts ("VIPs", "March Cohort"). Membership
// is denormalised onto SavedContact.groupIds to keep group selection cheap
// without a join table.
model ContactGroup {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  color        String   @default("#25D366")
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// Audit trail of every detected opt-out. Append-only — used by /admin and
// future analytics surfaces. Do NOT delete rows when re-opting a contact
// in; the contact's optedOut flag is the live state, this table is history.
model OptOutLog {
  id          String   @id @default(cuid())
  userId      String
  phoneNumber String
  keyword     String // exact word the user sent ("STOP", "UNSUBSCRIBE", ...)
  source      String   @default("whatsapp")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// ── Phase 6: two-way messaging (inbox) ───────────────────────────────────
// Every non-keyword inbound WhatsApp message lands here. Opt-out keywords
// are handled separately by lib/optOut.ts and DO NOT create an inbox row.
//
// `contactName` is denormalised at insert time so the inbox list doesn't
// need to JOIN SavedContact for the common rendering case. If the user
// later edits the contact's Name field, old inbox rows keep the snapshot.
//
// `campaignId` is best-effort — the most recent campaign that sent to
// this phone gets credit. Useful for "you got 3 replies to MFAC Meeting".
model InboundMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromPhone   String
  contactName String?
  messageText String
  messageId   String? // Meta's wamid, when present
  read        Boolean   @default(false)
  readAt      DateTime?
  repliedAt   DateTime?
  campaignId  String?
  createdAt   DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Phase 8 — webhook API. Per-user API keys for triggering WhatsApp
// sends from external platforms (Zapier, Make, n8n, custom code). The
// plain key is shown to the user ONCE at creation; only the bcrypt
// hash is stored. keyPrefix + keySuffix exist purely for "is this the
// key labelled Zapier?" UI display — never enough to reconstruct.
model ApiKey {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // user-given label, e.g. "Zapier"
  keyHash      String       @unique // bcrypt hash of the full key
  keyPrefix    String // first 12 chars: "sr_live_abcd"
  keySuffix    String // last 4 chars
  isActive     Boolean      @default(true)
  lastUsedAt   DateTime?
  requestCount Int          @default(0)
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?
  logs         WebhookLog[]

  @@index([userId])
  @@index([keyPrefix, isActive])
}

// One row per webhook trigger attempt — successful, failed, OR
// rate-limited. Surfaces in /settings/api-keys per-key log AND
// /admin/api-usage platform-wide stats.
model WebhookLog {
  id             String   @id @default(cuid())
  apiKeyId       String
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId         String
  phoneNumber    String
  messageType    String // freeform | template
  templateName   String?
  variables      String? // JSON
  status         String // success | failed | rate_limited | invalid
  errorMessage   String?
  whatsappMsgId  String?
  responseTimeMs Int?
  createdAt      DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// In-app customer support requests. Created via POST /api/support;
// surfaced on /support (per-user history) and /admin/support (admin
// triage). `reference` is the human-friendly ticket number that admins
// quote in emails — format SR-YYYY-NNN where NNN is the user's PERSONAL
// ticket count, not a global counter, so each user's first ticket is
// always SR-<year>-001 regardless of how many other users have written
// in.
model SupportRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference  String    @unique
  category   String
  subject    String
  message    String
  priority   String    @default("normal") // low | normal | high | urgent
  status     String    @default("open") // open | in_progress | resolved | closed
  adminNotes String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([priority])
}

// Replies sent from the inbox detail panel. Stored separately from the
// Campaign/Contact pipeline so inbox stats (replies sent, response rate)
// stay clean.
model OutboundReply {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboundMessageId String
  toPhone          String
  messageText      String
  sentAt           DateTime @default(now())
  whatsappMsgId    String?
  status           String   @default("sent") // sent | failed

  @@index([userId])
  @@index([inboundMessageId])
}

// Post-campaign performance insights. Created by the alert engine
// (lib/campaignAlerts.ts) exactly once per campaign, after the send
// loop completes. Surfaces on the campaign detail page and the
// dashboard unread-alerts banner, plus a copy is emailed to the user.
model CampaignAlert {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String   // success | warning | critical | info
  category       String   // delivery | engagement | optout | compliance | general
  title          String
  message        String
  recommendation String?
  metric         String?  // e.g. "82%" or "9 failed"
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, isRead])
  @@index([campaignId])
}

// Recurring date-driven automations (birthdays, anniversaries,
// custom yearly dates). One row per configured automation; each
// automation owns a set of AutomationContact rows (the recipient
// list, with their birth/anniversary month+day extracted at
// upload time) and produces one AutomationRun per daily-cron tick
// that actually sends anything.
model Automation {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  type             String    // birthday | anniversary | custom_date
  status           String    @default("active") // active | paused | archived

  // Message configuration
  mode             String    @default("freeform") // freeform | template
  message          String?
  templateName     String?
  templateLanguage String?   @default("en_US")
  variableMap      String?   // JSON — VariableMapping[]

  // Contact configuration
  contacts         AutomationContact[]
  phoneColumn      String
  dateColumn       String
  defaultCountryCode String  @default("1")

  // Schedule. sendHour/sendMinute are informational (the actual
  // cron fires once per day at a global UTC time — see
  // lib/automationEngine.ts); daysBeforeDate lets a user send N
  // days ahead of the actual date (e.g. "send anniversary
  // greetings 1 day early").
  sendHour         Int       @default(9)
  sendMinute       Int       @default(0)
  daysBeforeDate   Int       @default(0)
  timezone         String    @default("America/Los_Angeles")

  // Stats
  totalSent        Int       @default(0)
  lastRunAt        DateTime?
  nextRunAt        DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  runs             AutomationRun[]

  @@index([userId])
  @@index([status])
}

// One row per contact in an automation. month/day are precomputed
// at upload time so the daily cron's date-match query is a cheap
// indexed lookup instead of parsing rowData for every automation
// on every tick. lastSentYear is the double-send guard — a contact
// is never messaged more than once per calendar year.
model AutomationContact {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId       String

  phoneNumber  String
  name         String?
  dateValue    String     // original date string from the upload
  month        Int
  day          Int
  rowData      String     // JSON — full CSV row for template variables

  lastSentAt   DateTime?
  lastSentYear Int?
  totalSent    Int        @default(0)
  isActive     Boolean    @default(true)

  createdAt    DateTime   @default(now())

  @@index([automationId, isActive])
  @@index([automationId, month, day])
  @@index([userId])
}

// Audit trail — one row per daily cron pass that actually sent
// (or attempted to send) anything for a given automation.
// Surfaces on the automation detail page as "Run history".
model AutomationRun {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId        String

  runDate       DateTime
  contactsFound Int
  sent          Int        @default(0)
  failed        Int        @default(0)
  skipped       Int        @default(0)
  status        String     @default("completed") // completed | partial | failed
  errorMessage  String?

  createdAt     DateTime   @default(now())

  @@index([automationId, runDate])
  @@index([userId])
}

// One row per PDF report generation. Used only for per-account rate
// limiting (20/hour) so a loop can't exhaust the function budget.
// Rows are read by count-in-window; they can be pruned by a future
// cron if the table grows large — not needed at Pro-only volumes.
model ReportGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "campaign" | "range"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Per-client label owned by a Pro user. Clients are NOT tenants —
// there is no login, permissions, or data isolation between them.
// They exist only so a Pro user can filter their own analytics and
// PDF reports by which of their downstream clients a campaign or
// address-book contact belongs to.
//
// Delete + archive semantics
// - Archiving hides the client from create/assign UI but keeps it
//   visible in historical reports and filter lists.
// - Hard deleting a client clears the label on every SavedContact
//   and Campaign that referenced it (onDelete: SetNull) — it never
//   removes the underlying rows or their message history.
//
// The (userId, name) unique constraint prevents an agency from
// accidentally creating duplicate labels for the same downstream
// client (case-sensitive; UI should normalize before submit).
model Client {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  color         String?  // hex like "#25D366" for UI chips; UI defaults if null
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns     Campaign[]
  savedContacts SavedContact[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, archived])
}
