generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per Clerk user. The id field IS the Clerk user id (e.g. "user_abc")
// — no extra mapping table needed. Defaults + per-user Meta credentials live
// here too, replacing the previous singleton Settings model.
model User {
  id        String  @id // Clerk userId
  email     String  @unique
  firstName String?
  lastName  String?

  // Per-user Meta WhatsApp Cloud API credentials. Token is encrypted at rest
  // via lib/encrypt.ts (AES-256-CBC). Never returned to the browser raw.
  whatsappApiToken          String? // encrypted: "<iv-hex>:<ciphertext-hex>"
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  whatsappApiVersion        String  @default("v25.0")
  webhookVerifyToken        String?

  // User-level defaults (replaces the Settings singleton).
  defaultCountryCode String @default("1")
  defaultDelayMs     Int    @default(2000)

  // Set the first time the user finishes the onboarding wizard — either by
  // saving their Meta credentials OR by clicking "Skip for now". Used by /
  // and /onboarding to know whether to send the user through setup. Acts as
  // a belt-and-suspenders against Clerk's NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL
  // not being configured in every environment.
  onboardingCompletedAt DateTime?

  // ── Billing (Phase 4) ─────────────────────────────────────────────────
  // Plan id matches keys in lib/stripe.ts PLANS — the single source of truth
  // for limits/features. NEVER hardcode plan limits anywhere else.
  plan String @default("free") // free | starter | growth

  // Stripe customer + subscription identity. Set the first time the user
  // hits checkout; updated on every subscription event via the webhook.
  stripeCustomerId         String? @unique
  stripeSubscriptionId     String? @unique
  stripeSubscriptionStatus String? // active | canceled | past_due | trialing | incomplete | null
  stripePriceId            String?

  // Stripe-reported billing period (for "renews on" / "access until" copy).
  // Distinct from usagePeriodStart below: these come from Stripe and reflect
  // the SUBSCRIPTION's period, while usagePeriod tracks the message counter.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // True when the user has cancelled but still has access until period end.
  cancelAtPeriodEnd Boolean @default(false)

  // ── Usage tracking ─────────────────────────────────────────────────────
  // Counter reset to 0 by the invoice.paid webhook each billing cycle.
  messagesUsedThisMonth Int      @default(0)
  usagePeriodStart      DateTime @default(now())

  // ── Moderation (Phase 5 admin) ─────────────────────────────────────────
  // When true, send + template-create routes return 403 with a support copy.
  // Toggled from /admin/users/[id]/suspend.
  suspended Boolean @default(false)

  campaigns Campaign[]
  templates MessageTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id String @id @default(cuid())

  // userId is nullable during the Phase 3 transition. Once all existing rows
  // have been backfilled (or wiped), this is changed to required.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  mode         String
  templateName String?
  rawMessage   String?
  staticVars   String    @default("{}")
  variableMap  String    @default("[]")
  formatRules  String    @default("{}")
  phoneColumn  String
  delayMs      Int       @default(2000)
  status       String    @default("draft")
  totalCount   Int       @default(0)
  sentCount    Int       @default(0)
  failedCount  Int       @default(0)
  skippedCount Int       @default(0)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  contacts     Contact[]

  @@index([userId])
}

model Contact {
  id                  String    @id @default(cuid())
  campaignId          String
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phoneNumber         String
  rowData             String
  personalizedMessage String
  whatsappMsgId       String?
  status              String    @default("pending")
  errorMessage        String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?

  @@index([campaignId])
  @@index([whatsappMsgId])
}

model MessageTemplate {
  id String @id @default(cuid())

  // userId is nullable during the Phase 3 transition. See Campaign.userId.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  content     String
  staticVars  String    @default("{}")
  formatRules String    @default("{}")
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// DEPRECATED: replaced by per-user fields on the User model. Kept temporarily
// so existing code paths keep compiling during the Phase 3 transition. Will
// be removed after settings UI is migrated to the User record.
model Settings {
  id                 String @id @default("singleton")
  defaultCountryCode String @default("1")
  defaultDelayMs     Int    @default(2000)
}

// ── Phase 5: admin observability ─────────────────────────────────────────
// Captured by lib/errorLog.ts in catch blocks of critical routes (send,
// webhooks, settings). Surfaced in /admin/system. Should NEVER contain
// decrypted credentials — log the route name + sanitized message only.
model ErrorLog {
  id        String   @id @default(cuid())
  route     String
  message   String
  stack     String?
  userId    String?
  severity  String   @default("error") // error | warning
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity])
}

// In-app banner created in /admin/announcements. Only one row should be
// active at any time — publishing a new banner deactivates existing ones
// (handled in the API route's transaction).
model Announcement {
  id        String   @id @default(cuid())
  message   String
  type      String   @default("info") // info | warning | success
  target    String   @default("all")  // all | free | paid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}
