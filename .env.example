# ─────────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API credentials
# Get these from https://developers.facebook.com → your app → WhatsApp
# Full walkthrough: see SETUP.md
# ─────────────────────────────────────────────────────────────────────────

# Permanent System User access token.
# Dashboard path: Business Settings → System Users → Generate New Token
# Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_API_TOKEN=

# Phone number ID of the WhatsApp number registered to your app.
# Dashboard path: WhatsApp → API Setup → "From" dropdown → copy "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA).
# Dashboard path: WhatsApp → API Setup → just below the phone number selector
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Graph API version. v25.0 is current at time of writing.
WHATSAPP_API_VERSION=v25.0

# Any random string you choose. You'll paste this same string into Meta's
# webhook setup so Meta can prove it's talking to your server.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────

# Public base URL of this app (used for webhook URL display in /settings).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# SQLite file location for Prisma. The default works for local dev.
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────────────────
# Google Drive Integration (optional)
# Set up at console.cloud.google.com — see GOOGLE_DRIVE_SETUP.md
# Enable: Drive API, Picker API, Sheets API
# Leave these blank to hide the "Pick from Drive" button.
# ─────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Clerk Authentication — see AUTH_SETUP.md
# Sign up at clerk.com → create application → copy keys.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
# Set after creating the webhook endpoint in Clerk dashboard
CLERK_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────
# Encryption for per-user Meta API tokens (AES-256-CBC). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-char hex string (32 bytes = 256 bits).
# Once set, NEVER change — rotating breaks every stored encrypted token.
# ─────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Stripe Billing — see STRIPE_SETUP.md
# Use TEST keys (sk_test_, pk_test_) during development.
# Switch to LIVE keys (sk_live_, pk_live_) for production.
# ─────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set after creating the Stripe webhook endpoint in the dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
# Create the two Products in Stripe → copy each Price ID here
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
# One-time price for the $149 Done-For-You Setup service. Create it in
# Stripe → Product Catalog as a one-time (not recurring) price.
STRIPE_SETUP_SERVICE_PRICE_ID=price_...

# ─────────────────────────────────────────────────────────────────────────
# Admin Dashboard — see ADMIN_SETUP.md
# Comma-separated email allowlist. Server-side only — no NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=

# Resend (resend.com) — for /admin email broadcast. Verify your sending
# domain in Resend before broadcast will work in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SwiftReach <hello@swiftreach.app>

# ─────────────────────────────────────────────────────────────────────────
# Phase 6 — Scheduled campaigns cron
# Random secret that Vercel Cron sends in the x-cron-secret header. Generate:
#   openssl rand -hex 16
# Without this set, /api/cron/send-scheduled refuses every request.
# ─────────────────────────────────────────────────────────────────────────
CRON_SECRET=

# Meta Embedded Signup
# App ID is public (NEXT_PUBLIC_ prefix)
# App Secret is private — never expose to browser.
# System User Token is server-only, used to subscribe each connected
# WABA to your app's webhooks. Generated in Meta Business Settings →
# System Users with whatsapp_business_management permission.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=

# Embedded Signup Configuration ID — created in your Meta app under
# WhatsApp → Embedded Signup → Create Configuration. Public (browser
# needs it to launch FB.login).
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
